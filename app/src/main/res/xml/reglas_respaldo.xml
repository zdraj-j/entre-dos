<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior. La base no entra en la copia automática de Google:
     al reinstalar, los datos vuelven desde Drive y no se duplican. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="entre_dos.db" />
        <exclude domain="database" path="entre_dos.db-wal" />
        <exclude domain="database" path="entre_dos.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="entre_dos.db" />
        <exclude domain="database" path="entre_dos.db-wal" />
        <exclude domain="database" path="entre_dos.db-shm" />
    </device-transfer>
</data-extraction-rules>
